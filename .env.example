# ==============================================================================
# Xeno Craft Ecommerce - Frontend Environment Configuration
# Copy this file to .env or .env.local and populate the values for your environment
# ==============================================================================

# Backend API Base URL
# Default local Laravel backend API endpoint
VITE_API_URL=http://localhost:8000/api/v1

# Razorpay Payment Gateway (Test or Live Key ID)
# Used during the checkout process for initiating payments
VITE_RAZORPAY_KEY=rzp_test_placeholder

# Optional: Cloud Name (if using client-side direct transformations / delivery)
# Note: Uploads and signatures are securely routed through the Laravel backend API
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
